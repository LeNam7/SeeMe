# Database: Leave empty to use persistent local PGlite PostgreSQL in ./data/pgdata
# Set postgresql://user:pass@host:5432/seemee in production PostgreSQL
DATABASE_URL=

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=seemee-admin-change-me
ADMIN_SESSION_SECRET=replace-with-32-char-random-secret

# Site URL (used for SEO metadata, VietQR callbacks, Zalo links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# VietQR Bank Account & Payment Webhook Verification
VIETQR_BANK_BIN=970436
VIETQR_BANK_NAME=Vietcombank
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=SEEME HOMESTAY
VIETQR_TEMPLATE=compact2
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# Zalo Official Account (OA) / ZNS Adapter (optional - logs honest PENDING_CONFIG when omitted)
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_ID=
ZALO_OWNER_USER_ID=
ZALO_TEMPLATE_BOOKING_CREATED=
